# Copy this file to `.env` (same directory) and fill in your own values.
# `.env` is git-ignored - never commit real secrets.
#
# Alternative: store SLSKD_API_KEY / SPOTIFY_CLIENT_SECRET in the Windows
# Credential Manager instead (see README.md, "Storing secrets"), and leave
# the corresponding line here blank/omitted.

# --- slskd connection -------------------------------------------------
SLSKD_BASE_URL=http://localhost:5030
SLSKD_API_BASE_PATH=/api/v0
# Preferred auth method: an API key configured in slskd's web.authentication.api_keys
SLSKD_API_KEY=
# Alternative auth method (used only if SLSKD_API_KEY is blank):
SLSKD_USERNAME=
SLSKD_PASSWORD=
# Adjust these ONLY if your slskd version's /swagger shows a different path.
SLSKD_DOWNLOADS_PATH=/downloads
SLSKD_UPLOADS_PATH=/uploads
SLSKD_SEARCHES_PATH=/searches
SLSKD_USERS_PATH=/users

# --- Spotify (metadata only - see ARCHITECTURE.md) ---------------------
# Create an app at https://developer.spotify.com/dashboard to get these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- storage -------------------------------------------------------------
# SQLite database file
DATABASE_URL=sqlite:///./data/app.db
# Where finished FLAC files are organized into Artist/Year - Album/...
LIBRARY_ROOT=./data/Music
# Where slskd actually writes completed downloads on THIS machine - must
# match slskd's own "downloads" directory setting.
DOWNLOADS_INCOMING_DIR=./data/incoming

# --- behaviour -------------------------------------------------------------
STRICT_FLAC_ONLY=true
MODE=SAFE
DUPLICATE_POLICY=SKIP
REWRITE_METADATA=false
SEARCH_RATE_LIMIT_PER_MINUTE=12
DOWNLOAD_STATUS_POLL_SECONDS=5
